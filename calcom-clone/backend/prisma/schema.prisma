datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  email      String                 @unique
  timezone   String                 @default("Asia/Kolkata")
  createdAt  DateTime               @default(now()) @map("created_at")
  eventTypes EventType[]
  schedules  AvailabilitySchedule[]
  @@map("users")
}

model EventType {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  title           String
  slug            String    @unique
  description     String?
  durationMinutes Int       @map("duration_minutes")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  user            User      @relation(fields: [userId], references: [id])
  bookings        Booking[]
  @@map("event_types")
}

model AvailabilitySchedule {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  name      String             @default("Working Hours")
  timezone  String             @default("Asia/Kolkata")
  isDefault Boolean            @default(true) @map("is_default")
  user      User               @relation(fields: [userId], references: [id])
  rules     AvailabilityRule[]
  @@map("availability_schedules")
}

model AvailabilityRule {
  id         String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scheduleId String               @map("schedule_id") @db.Uuid
  dayOfWeek  Int                  @map("day_of_week")
  startTime  String               @map("start_time")
  endTime    String               @map("end_time")
  schedule   AvailabilitySchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  @@map("availability_rules")
}

model Booking {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventTypeId  String    @map("event_type_id") @db.Uuid
  bookerName   String    @map("booker_name")
  bookerEmail  String    @map("booker_email")
  bookingDate  String    @map("booking_date")
  startTime    String    @map("start_time")
  endTime      String    @map("end_time")
  status       String    @default("confirmed")
  cancelReason String?   @map("cancel_reason")
  createdAt    DateTime  @default(now()) @map("created_at")
  eventType    EventType @relation(fields: [eventTypeId], references: [id])
  @@map("bookings")
}
